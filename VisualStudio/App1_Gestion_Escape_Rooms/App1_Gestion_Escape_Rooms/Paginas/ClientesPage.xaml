<Page x:Class="App1_Gestion_Escape_Rooms.Paginas.ClientesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Clientes">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gestión de clientes"
                   FontSize="25"
                   FontWeight="Bold"
                   Margin="0,0,0,18"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="0,0,15,5">
                <Label Content="DNI"/>
                <TextBox x:Name="txtDni" Width="110"
                         Text="{Binding SelectedItem.Dni, ElementName=dgClientes, Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Margin="0,0,15,5">
                <Label Content="Nombre"/>
                <TextBox x:Name="txtNombre" Width="180"
                         Text="{Binding SelectedItem.Nombre, ElementName=dgClientes, Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Margin="0,0,15,5">
                <Label Content="Email"/>
                <TextBox x:Name="txtEmail" Width="220"
                         Text="{Binding SelectedItem.Email, ElementName=dgClientes, Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Margin="0,0,15,5">
                <Label Content="Teléfono"/>
                <TextBox x:Name="txtTelefono" Width="120"
                         Text="{Binding SelectedItem.Telefono, ElementName=dgClientes, Mode=OneWay}"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel Grid.Row="2" Margin="0,0,0,15">
            <Button Content="Actualizar" Width="100" Height="34" Margin="0,0,10,5" Click="Actualizar_Click"/>
            <Button Content="Insertar"   Width="100" Height="34" Margin="0,0,10,5" Click="Insertar_Click"/>
            <Button Content="Modificar"  Width="100" Height="34" Margin="0,0,10,5" Click="Modificar_Click"/>
            <Button Content="Eliminar"   Width="100" Height="34" Margin="0,0,10,5" Click="Eliminar_Click"/>
        </WrapPanel>

        <DataGrid x:Name="dgClientes"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdCliente}" Width="60"/>
                <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="100"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txtEstado" Grid.Row="4" Margin="0,12,0,0" Foreground="Gray"/>
    </Grid>
</Page>