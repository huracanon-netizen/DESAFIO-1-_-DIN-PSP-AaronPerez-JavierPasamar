<Page x:Class="App1_Gestion_Escape_Rooms.Paginas.TematicasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Temáticas">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gestión de temáticas"
                   FontSize="25"
                   FontWeight="Bold"
                   Margin="0,0,0,18"/>

        <DataGrid x:Name="dgTematicas"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="dgTematicas_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdTematica}" Width="50"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Margin="0,0,15,5">
                <Label Content="Nombre"/>
                <TextBox x:Name="txtNombre" Width="200"/>
            </StackPanel>

            <StackPanel Margin="0,0,15,5">
                <Label Content="Descripción"/>
                <TextBox x:Name="txtDescripcion" Width="400"/>
            </StackPanel>
        </WrapPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Guardar" Width="100" Height="32" Margin="0,0,10,0" Click="Guardar_Click"/>
            <Button Content="Nueva / Limpiar" Width="120" Height="32" Margin="0,0,10,0" Click="Limpiar_Click"/>
            <Button Content="Eliminar" Width="100" Height="32" Click="Eliminar_Click"/>
        </StackPanel>
    </Grid>
</Page>
