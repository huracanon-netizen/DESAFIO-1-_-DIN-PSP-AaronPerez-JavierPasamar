<Window x:Class="App1_Gestion_Escape_Rooms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión Escape Rooms"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Menú superior -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Gestión">
                <MenuItem Header="Clientes" Click="MenuClientes_Click"/>
                <MenuItem Header="Temáticas" Click="MenuTematicas_Click"/>
                <MenuItem Header="Salas" Click="MenuSalas_Click"/>
                <MenuItem Header="Monitores" Click="MenuMonitores_Click"/>
                <MenuItem Header="Reservas" Click="MenuReservas_Click"/>
                <MenuItem Header="Resultados" Click="MenuResultados_Click"/>
            </MenuItem>

            <MenuItem Header="Procesar">
                <MenuItem Header="Enviar reserva a procesar" Click="MenuProcesarReserva_Click"/>
            </MenuItem>

            <MenuItem Header="Ayuda">
                <MenuItem Header="Acerca de" Click="MenuAcercaDe_Click"/>
            </MenuItem>
        </Menu>

        <!-- Zona central donde se cargan las pantallas -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>