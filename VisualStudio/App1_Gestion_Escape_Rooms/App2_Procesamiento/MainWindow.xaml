<Window x:Class="App2_Procesamiento.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App2_Procesamiento"
        mc:Ignorable="d"
        Title="Servicio de procesamiento" Height="520" Width="900"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Ayuda">
                <MenuItem Header="Acerca de" Click="AcercaDe_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Registro de peticiones"
                       FontSize="25"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <DataGrid x:Name="dgPeticiones"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID de petición"
                                        Binding="{Binding IdPeticion}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Fecha y hora"
                                        Binding="{Binding FechaHoraRecepcion}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Tipo de operación"
                                        Binding="{Binding TipoOperacion}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Estado final"
                                        Binding="{Binding EstadoFinal}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Error técnico"
                                        Binding="{Binding ErrorTecnico}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="2"
                    Content="Ver detalle"
                    Width="110"
                    Height="34"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Click="VerDetalle_Click"/>
        </Grid>
    </DockPanel>
</Window>