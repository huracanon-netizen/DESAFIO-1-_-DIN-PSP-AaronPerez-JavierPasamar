<Window x:Class="App2_Procesamiento.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App2_Procesamiento"
        mc:Ignorable="d"
        Title="Servicio de procesamiento" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Peticiones recibidas"
                   FontSize="25"
                   FontWeight="Bold"
                   Margin="0,0,0,18"/>

        <ListBox x:Name="lstPeticiones"
                 Grid.Row="1"/>
    </Grid>
</Window>