<Window x:Class="App2_Procesamiento.AcercaDeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App2_Procesamiento"
        mc:Ignorable="d"
        Title="Acerca de" Height="330" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Servicio de procesamiento"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <Label Content="Aplicación: Gestión de Escape Rooms - Aplicación 2"/>
            <Label Content="Integrantes: Aarón Pérez Ruiz y Javier Pasamar"/>
            <Label Content="Fecha de creación: 19/10/2026"/>
            <Label Content="Versión: 1.0"/>

            <Button Content="Cerrar"
                    Width="100"
                    Height="32"
                    Margin="0,25,0,0"
                    HorizontalAlignment="Right"
                    Click="Cerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>