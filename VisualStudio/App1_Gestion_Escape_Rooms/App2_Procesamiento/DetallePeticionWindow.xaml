<Window x:Class="App2_Procesamiento.DetallePeticionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App2_Procesamiento"
        mc:Ignorable="d"
        Title="Detalle de la petición" Height="760" Width="520"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <StackPanel>
            <Label Content="Id de petición"/>
            <TextBox x:Name="txtId" IsReadOnly="True" Margin="0,0,0,6"/>
            <Label Content="Fecha y hora de recepción"/>
            <TextBox x:Name="txtFecha" IsReadOnly="True" Margin="0,0,0,6"/>
            <Label Content="Tipo de operación"/>
            <TextBox x:Name="txtTipo" IsReadOnly="True" Margin="0,0,0,6"/>
            <Label Content="Estado final"/>
            <TextBox x:Name="txtEstado" IsReadOnly="True" Margin="0,0,0,6"/>
            <Label Content="Campo con error"/>
            <TextBox x:Name="txtCampo" IsReadOnly="True" Margin="0,0,0,6"/>
            <Label Content="Detalle del error"/>
            <TextBox x:Name="txtDetalle" IsReadOnly="True" Margin="0,0,0,6"/>
            <Label Content="Error técnico"/>
            <TextBox x:Name="txtTecnico" IsReadOnly="True" Margin="0,0,0,6"/>
            <Label Content="Puntuación"/>
            <TextBox x:Name="txtPuntuacion" IsReadOnly="True" Margin="0,0,0,6"/>
            <Label Content="Clasificación"/>
            <TextBox x:Name="txtClasificacion" IsReadOnly="True" Margin="0,0,0,6"/>
            <Label Content="JSON recibido"/>
            <TextBox x:Name="txtJson"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Height="100"
                     Margin="0,0,0,12"/>

            <Button Content="Cerrar"
                    Width="100"
                    Height="32"
                    HorizontalAlignment="Right"
                    Click="Cerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>